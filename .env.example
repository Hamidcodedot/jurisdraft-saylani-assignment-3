# ==========================================================
# Pre-Legal SaaS — Environment Configuration
# Copy this file to .env: cp .env.example .env
# ==========================================================

# Server Port & Host
PORT=8000
ENVIRONMENT=development

# JWT Authentication Secret Key
SECRET_KEY=prelegal-super-secret-production-key-2026-smit-assignment

# AI Inference (Cerebras Skill via OpenRouter)
# Get a key at https://openrouter.ai/ or https://cerebras.ai/
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Model specification (defaults to openai/gpt-oss-120b on Cerebras)
CEREBRAS_MODEL=openrouter/openai/gpt-oss-120b

# Database URL (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./backend/prelegal.db
